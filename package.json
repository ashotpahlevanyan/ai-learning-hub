{
  "name": "ai-learning-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check:links": "node scripts/check-links.mjs",
    "content:normalize": "node scripts/normalize-content.mjs",
    "content:export": "vite-node scripts/export-content.ts",
    "test:e2e": "node e2e/smoke.mjs",
    "content:verify-db": "vite-node scripts/verify-db.ts",
    "test:e2e:db": "node e2e/db.mjs",
    "check:rechecks": "node scripts/check-rechecks.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "katex": "0.16.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "react-router-dom": "6.28.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.0",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright-core": "1.47.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
